{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-km2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1eb258a5-33ac-4327-a6c4-72945b60efb2","database_name": "nova-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9050480e213943439009e19c0a283f6f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
